
{%- style -%}
.discount-badge{
    background: {{ section.settings.discount_bg_color }};
    color: {{ section.settings.discount_text_color }};
    border: 1px solid {{ section.settings.discount_border_color }};
}
.custom-badge {
    background: {{ section.settings.custom_bg_color }};
    color: {{ section.settings.custom_text_color }};
    border: 1px solid {{ section.settings.custom_border_color }};
}
.show_more {
    background: {{ section.settings.more_bg_color }};
    color: {{ section.settings.more_text_color }};
    border: 1px solid {{ section.settings.more_border_color }};
}
{%- endstyle -%}
<div class="mt-12 mb-8">
    <div class="sm:ml-[15px] sm:mr-[15px]">
        <div class="page-width">
            <div class=" flex items-center max-sm:flex-col max-sm:justify-center sm:justify-between md:justify-between capitalize mb-6 gap-[15px]">
                <div>
                    {%- if section.settings.heading != blank -%}
                        <h2 class="font-bold text-3xl"><span>{{ section.settings.heading }}</span></h2>
                    {%- endif -%}
                </div>
                {%- if section.settings.view_button == true and section.settings.view_button_text != blank -%}
                    <a href="{{ section.settings.collection.url }}" class="text-sm" aria-label="{{ section.settings.view_button_text }}">
                        <span class="flex items-center gap-[5px]">{{ section.settings.view_button_text }}{{ 'icon-arrow.svg' | inline_asset_content }}</span>
                    </a>
                {%- endif -%}
            </div>
        </div>
    </div>
    <div class="sm:ml-[15px]">
        <div class="scrollbar-bottom page-width">
            <div class="max-sm:grid max-sm:grid-cols-2 sm:flex md:flex gap-[15px]  stretch-container pb-10">
                {%- for product in section.settings.collection.products -%}
                    <div class="flex-shrink-0 sm:w-64 md:w-64 multi-card {% if forloop.index > 4 %}max-sm:hidden{% endif %}">
                        <div class="relative">
                        
                            {%- liquid
                                assign media = product.selected_or_first_available_variant.featured_media | default: product.featured_media
                                assign second_image = 1
                                if product.media[1] != null and product.media[1].id == media.id
                                assign second_image = 0
                                endif
                            -%}
                            <a href="{{ product.url }}">
                                <img srcset="
                                {%- if media.width >= 165 -%}{{ media | image_url: width: 165 }} 165w,{%- endif -%}
                                {%- if media.width >= 360 -%}{{ media | image_url: width: 360 }} 360w,{%- endif -%}
                                {%- if media.width >= 530 -%}{{ media | image_url: width: 530 }} 530w,{%- endif -%}
                                {%- if media.width >= 720 -%}{{ media | image_url: width: 720 }} 720w,{%- endif -%}
                                {{ media | image_url }} {{ media.width }}w"
                                src="{{ media | image_url: width: 530 }}"
                                alt="{{ media.alt | escape }}"
                                loading="lazy"
                                class="rounded-lg"
                                width="{{ media.width }}"
                                height="{{ media.height }}">
                                
                                {%- if product.media[second_image] != null -%}
                                    <img srcset="
                                    {%- if product.media[second_image].width >= 165 -%}{{ product.media[second_image] | image_url: width: 165 }} 165w,{%- endif -%}
                                    {%- if product.media[second_image].width >= 360 -%}{{ product.media[second_image] | image_url: width: 360 }} 360w,{%- endif -%}
                                    {%- if product.media[second_image].width >= 530 -%}{{ product.media[second_image] | image_url: width: 530 }} 530w,{%- endif -%}
                                    {%- if product.media[second_image].width >= 720 -%}{{ product.media[second_image] | image_url: width: 720 }} 720w,{%- endif -%}
                                    {{ product.media[second_image] | image_url }} {{ product.media[second_image] }}w"
                                    src="{{ product.media[second_image] | image_url: width: 530 }}"
                                    alt="{{ product.media[second_image].width.alt | escape }}"
                                    class="second-image absolute inset-0 rounded-lg"
                                    loading="lazy"
                                    width="{{ product.media[second_image].width }}"
                                    height="{{ product.media[second_image].width.height }}">
                                {%- endif -%}
                            </a>


                            {%- liquid
                                if product.compare_at_price > product.price
                                assign badge_sale_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round
                                
                                endif
                            -%}
                            {%- if product.compare_at_price != blank -%}
                                <span class="discount-badge absolute max-sm:right-[5px] max-sm:top-[5px] sm:right-[10px] sm:top-[10px] text-[10px] rounded-[20px] p-px px-[5px] uppercase">{{ 'badges.save' | t }} {{ badge_sale_percent }}%</span>
                            {%- endif -%}

                            {%- if product.metafields.custom.badge -%}
                                <span class="custom-badge absolute max-sm:left-[5px] max-sm:top-[5px] sm:left-[10px] sm:top-[10px] text-[10px] rounded-[20px] p-px px-[5px] uppercase">{{- product.metafields.custom.badge -}}</span>
                            {%- endif -%}

                        </div>
                        <div class="mt-3">
                            <h3 class="uppercase font-medium text-sm">
                                <a href="{{ product.url }}">
                                    {{ product.title | escape }}
                                </a>
                            </h3>
                            
                            <!-- Start of Judge.me code --> 
                            <div  class='jdgm-widget jdgm-preview-badge text-[12px] mt-2' data-id='{{ product.id }}' data-auto-install='false'> 
                            {{ product.metafields.judgeme.badge }} 
                            </div> 
                            <!-- End of Judge.me code -->

                            <div class="flex items-center gap-[5px] mt-2">
                                <span>{{ product.price | money }}</span>
                                {%- if product.compare_at_price != blank -%}
                                    <span class="line-through text-xs opacity-70">{{ product.compare_at_price | money }}</span>
                                {%- endif -%} 
                            </div>
                        </div>
                    </div>
                {%- endfor -%}
                
            </div>
        </div>
    </div>
</div>



{% schema %}
{
  "name": "Bestseller",
  "class": "bestseller",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },   
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Bestseller",
      "label": "Text"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },

    {
      "type": "header",
      "content": "View all button"
    },
    {
      "type": "checkbox",
      "id": "view_button",
      "default": true,
      "label": "View all button"
    },
    {
      "type": "text",
      "id": "view_button_text",
      "label": "Text",
      "default": "Shop all bestsellers",
      "visible_if": "{{ section.settings.view_button == true }}"
    },
    {
      "type": "header",
      "content": "Discount badge color"
    }, 
    {
      "type": "color",
      "id": "discount_bg_color",
      "default": "#5C7962",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "discount_text_color",
      "default": "#ffffff",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "discount_border_color",
      "default": "#000000",
      "label": "Border color"
    },

    {
      "type": "header",
      "content": "Custom badge color"
    }, 
    {
      "type": "color",
      "id": "custom_bg_color",
      "default": "#ffffff",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "default": "#000000",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "custom_border_color",
      "default": "#000000",
      "label": "Border color"
    },

    {
      "type": "header",
      "content": "Show more button",
      "info": "Applicable on mobile device."
    }, 
    {
      "type": "color",
      "id": "more_bg_color",
      "default": "#000000",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "more_text_color",
      "default": "#ffffff",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "more_border_color",
      "default": "#000000",
      "label": "Border color"
    }
  ],
  "presets": [
    {
      "name": "Bestseller"
    }
  ]
}
{% endschema %}
